# This file is the local-development template — for staging/production, start from
# .env.staging.example / .env.production.example instead, which carry the stricter requirements
# lib/env.ts's assertProductionSafety() enforces at boot (see that file for the exact checks:
# no localhost DATABASE_URL/AUTH_URL, S3 required, a real AUTH_SECRET, RATE_LIMIT_DISABLED never
# set). APP_ENV distinguishes the three — see lib/env.ts#getAppEnv — and defaults to "development"
# here so local dev needs no extra setup; leave it unset locally.
# APP_ENV="development"

# Local dev: run `npm run db:start` (spins up a real, persistent, local PostgreSQL instance —
# no Docker or admin rights needed — then prints this exact URL) or point at any real Postgres.
# Production/staging: point at a managed provider (RDS, Cloud SQL, Neon, Supabase, ...).
# connection_limit/pool_timeout size Prisma's own pool; a high-concurrency serverless deployment
# should sit this behind PgBouncer or Prisma Accelerate instead of relying on this pool alone.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_career_agent?schema=public&connection_limit=10&pool_timeout=20"

# Auth.js v5 — generate your own with `npx auth secret`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# DATABASE_URL and AUTH_SECRET above are the only two required vars — lib/env.ts validates them
# at boot (instrumentation.ts) and fails fast with a clear error if either is missing. Everything
# below is optional; the app runs correctly with none of it set.

# Test/local-dev/CI only — disables rate limiting so integration tests (tests/integration/) can
# register many accounts in a tight loop without tripping the same limits a real attacker would.
# Double-gated on APP_ENV in lib/security/rateLimit.ts: a misconfigured production environment
# cannot accidentally disable rate limiting via this var (APP_ENV=production makes this a no-op
# regardless). Never set this outside local dev/CI.
# RATE_LIMIT_DISABLED="true"

# Optional: enables the production S3-compatible object storage provider (real AWS S3, Cloudflare
# R2, or any S3-API-compatible endpoint). Leave unset in local dev to fall back to local-disk
# storage. S3_ENDPOINT is only needed for non-AWS S3-compatible services; omit it for real AWS S3.
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# Optional: switches the AI provider from the built-in heuristic mock to real Claude-backed
# extraction/scoring-rationale/assistant calls. Leave unset to run fully offline.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"

# Optional: daily AI-spend ceiling per user (USD), enforced per calendar day in UTC by
# lib/ai/usageLimits.ts against the sum of AIInteraction.estimatedCostUsd for that user. Caps
# worst-case spend from a single account independent of the per-endpoint rate limits above.
# Defaults shown below are used when unset.
# AI_FREE_DAILY_BUDGET_USD="0.50"
# AI_PRO_DAILY_BUDGET_USD="5.00"

# Optional: enables the Adzuna licensed job-source import (free self-serve API, register at
# https://developer.adzuna.com/). Leave unset to keep manual-paste-only import.
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""

# Optional: enables real Stripe billing for the Pro plan. Create a Stripe account, a recurring
# Price for "Pro", and a webhook endpoint pointed at /api/billing/webhook (subscribed to
# customer.subscription.created/updated/deleted) at https://dashboard.stripe.com/. Leave unset
# to keep everyone on the Free plan with Settings showing "Stripe not connected".
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRO_PRICE_ID=""

# No email provider is wired in yet — password reset emails (and anything else the app sends)
# are written to the EmailLog table and viewable at /dev/outbox (disabled in production builds)
# instead of actually being delivered. To send real email, add a provider branch to
# lib/mail/index.ts#getMailProvider (e.g. Resend) and set its API key here.
# RESEND_API_KEY=""
