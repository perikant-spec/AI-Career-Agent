# Production environment template — set in the production deployment's hosting platform
# environment variable configuration, never committed as a real .env file and never copied from
# staging or dev. Every var below is enforced at boot by lib/env.ts's assertProductionSafety()
# (called automatically whenever APP_ENV resolves to "production" — see instrumentation.ts): the
# process refuses to start rather than silently serve production traffic against dev-shaped
# config. That function is the actual technical control here — this file is only the template
# for what it expects to find.
APP_ENV="production"

# Must NOT contain localhost/127.0.0.1 — assertProductionSafety() throws if it does. A managed
# provider (RDS, Cloud SQL, Neon, Supabase, ...), its own instance, never shared with staging.
DATABASE_URL="postgresql://<user>:<password>@<production-db-host>:5432/ai_career_agent?schema=public&connection_limit=10&pool_timeout=20"

# Must be a real, unique secret at least 32 characters — assertProductionSafety() throws
# otherwise. Generate with `npx auth secret`. Never reused from staging/dev.
AUTH_SECRET=""
# Must NOT contain localhost — assertProductionSafety() throws if it does.
AUTH_URL="https://app.example.com"

# Required in production — assertProductionSafety() throws if S3_BUCKET is unset, since the
# local-disk storage fallback (lib/storage/localDisk.ts) doesn't survive a redeploy and is
# explicitly dev-only. Its own bucket, never shared with staging.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="" # only for non-AWS S3-compatible services; omit for real AWS S3

# Optional but expected once the product is live — its own key/budget, separate from staging's.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
# AI_FREE_DAILY_BUDGET_USD="0.50"
# AI_PRO_DAILY_BUDGET_USD="5.00"

# Optional integrations — live-mode credentials, never test/sandbox keys.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRO_PRICE_ID=""
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""
# RESEND_API_KEY=""

# Must never be set in production — assertProductionSafety() throws if RATE_LIMIT_DISABLED is
# "true" here. Do not add this line even commented; it's omitted from this file entirely on
# purpose.
