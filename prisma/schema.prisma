// Enum-like fields are modeled as String (not Prisma `enum`) — the single source of truth is
// the TS unions in lib/types/enums.ts, checked at the application layer via zod/TS, not by the
// database. (This project ran on SQLite through initial development; it is Postgres from here
// on — see DATABASE_URL.)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Prisma's own connection pool, sized via the DATABASE_URL query string (see .env.example) —
  // e.g. ?connection_limit=10&pool_timeout=20. A high-concurrency serverless deployment should
  // sit this behind PgBouncer or Prisma Accelerate instead of relying on this pool alone, since
  // many short-lived function instances each holding their own pool can still exhaust Postgres's
  // own max_connections.
}

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev (Windows/Mac); "debian-openssl-3.0.x" matches the Dockerfile's
  // node:20-slim (Debian) runtime image so the query engine binary generated at build time
  // actually runs in the container — without this, `prisma generate` only ships the binary for
  // whatever OS ran the build, and the app crashes at boot inside a Linux container with no
  // matching engine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Only ever a bcrypt hash of the emailed token, never the raw token itself — same rule as
  // passwordHash. Single-use: cleared the moment a reset succeeds.
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?

  // Captured at registration (see lib/legal/documents.ts) — version is the LEGAL_DOCUMENTS
  // slug's version string at the moment of acceptance, not the current one, so a later legal-doc
  // update can be detected by comparing against LEGAL_DOCUMENTS's current version and trigger
  // re-consent rather than silently assuming an old acceptance still covers new terms.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  privacyAcceptedAt DateTime?
  privacyVersion    String?

  resumes               ResumeDocument[]
  profileEntries        CareerProfileEntry[]
  jobs                  Job[]
  matchScores           MatchScore[]
  resumeVersions        ResumeVersion[]
  applications          Application[]
  contacts              Contact[]
  outreachMessages      OutreachMessage[]
  followUps             FollowUp[]
  interviewPreps        InterviewPrep[]
  mockInterviewAttempts MockInterviewAttempt[]
  preferences           UserPreferences?
  aiInteractions   AIInteraction[]
  subscription          Subscription?
  pushTokens            PushToken[]
  dailyBriefingLogs     DailyBriefingLog[]
}

model ResumeDocument {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName         String
  storageKey       String
  mimeType         String
  fileSizeBytes    Int
  rawText          String   @default("")
  extractionStatus String   @default("PENDING") // PENDING | SUCCESS | PARTIAL | FAILED | UNSUPPORTED_FORMAT
  extractionError  String?
  isMaster         Boolean  @default(false)
  createdAt        DateTime @default(now())

  profileEntries CareerProfileEntry[]

  @@index([userId])
}

model CareerProfileEntry {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   ResumeDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  section        String // SUMMARY | SKILL | EXPERIENCE | EDUCATION | CERTIFICATION | ACHIEVEMENT
  label          String?
  value          String
  structuredData String? // JSON string, shape varies by section (e.g. experience bullets/dates)

  confidence      String // VERIFIED | SUPPORTED_INFERENCE | NOT_VERIFIED | MISSING
  basisText       String? // inference rationale — always shown as inference, never as fact
  sourceSpanStart Int?
  sourceSpanEnd   Int?
  sourceSpanText  String? // snapshotted exact substring, survives later resume edits

  orderIndex    Int     @default(0)
  userConfirmed Boolean @default(false)
  userEdited    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, section])
  @@index([sourceDocumentId])
}

model Job {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source       String // MANUAL_PASTE | ADZUNA
  sourceRef    String? // URL or external id — reference only, never fetched server-side for MANUAL_PASTE
  rawText      String
  title        String?
  company      String?
  locationText String?

  parsedRequirements   String? // JSON string: JobRequirements shape
  extractionConfidence String? // overall confidence — forced low for sparse postings

  createdAt DateTime @default(now())

  matchScores    MatchScore[]
  resumeVersions ResumeVersion[]
  applications   Application[]
  contacts       Contact[]

  @@index([userId])
}

model MatchScore {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  overallScore   Int
  categoryScores String // JSON: {skills, experience, seniority, industry, location, compensation, educationCertification, careerTrajectory}
  strengths      String // JSON string[]
  gaps           String // JSON string[]
  risks          String // JSON string[]
  disqualifiers  String // JSON string[] of {code, reason} — [] if none

  recommendationTier String // APPLY_STRONG | APPLY | APPLY_IF_INTERESTED | LOW_PRIORITY | DONT_APPLY
  confidenceNote     String? // e.g. "sparse job posting text"
  profileVersionHash String // detects staleness -> triggers recompute

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([jobId])
}

model ResumeVersion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // The customizer only ever reorders/rephrases entities that exist in the master resume — this
  // column is a snapshot of that output, not a freeform document, so "no new entity introduced"
  // stays structurally checkable later if needed.
  content   String // JSON: TailoredResumeContent shape (see lib/resume/customize.ts)
  changeLog String // JSON: Array<{ kind: string; text: string }>

  atsScoreBefore Int
  atsScoreAfter  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, jobId])
  @@index([jobId])
}

model Application {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // DISCOVERED | SHORTLISTED | PREPARING | READY_TO_APPLY | APPLIED | RECRUITER_CONTACT |
  // SCREENING | INTERVIEW | FINAL_INTERVIEW | OFFER | ACCEPTED | REJECTED | WITHDRAWN
  // Always user-driven — nothing here is ever set by a silent automated transition.
  status String @default("DISCOVERED")

  coverLetterContent String? // JSON: { text: string; citedEntityIds: string[] }
  qaAnswers          String? // JSON: Array<{ question: string; answer: string; citedEntityIds: string[] }>

  resumeApproved      Boolean @default(false)
  coverLetterApproved Boolean @default(false)
  qaApproved          Boolean @default(false)

  notes String?

  discoveredAt DateTime  @default(now())
  appliedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps     FollowUp[]
  interviewPrep InterviewPrep?

  @@unique([userId, jobId])
  @@index([userId, status])
  @@index([jobId])
}

model FollowUp {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  dueDate DateTime

  // PENDING | COMPLETED | DISMISSED — always user-driven; "due" is computed at read time
  // (dueDate <= now) rather than by any background job, since none exists in this build.
  status String @default("PENDING")

  draftedMessage String? // JSON: { content: string; citedEntityIds: string[] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status, dueDate])
  @@index([applicationId])
}

model InterviewPrep {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // JSON: Array<{ label: string; text: string }> — deterministically extracted from the job
  // posting's own raw text (mission/team/stack mentions), never fabricated general-knowledge
  // facts about the company. No web research/scraping capability exists in this build.
  companyResearch String

  // Deliberate deviation from this schema's plain-DateTime-everywhere convention: every other
  // DateTime here is either a same-process-relative timestamp or already effectively UTC-only in
  // meaning. scheduledAt is the one field whose entire purpose is "this absolute instant,
  // unambiguous regardless of the reading timezone" — a push notification fired hours off because
  // of implicit local-time storage would be a correctness bug, not cosmetic. Nullable: never
  // fabricate a time — if unset, the daily briefing falls back to an honest "You have an upcoming
  // interview" with no time claimed (see lib/briefing/subFacts.ts#resolveUpcomingInterview).
  scheduledAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions InterviewQuestion[]

  @@index([userId])
}

model InterviewQuestion {
  id              String        @id @default(cuid())
  interviewPrepId String
  interviewPrep   InterviewPrep @relation(fields: [interviewPrepId], references: [id], onDelete: Cascade)

  // BEHAVIORAL | TECHNICAL | ROLE_SPECIFIC | LEADERSHIP | COMPANY_FIT
  category String
  question String
  orderIndex Int @default(0)

  // STAR breakdown — entirely deterministic (lib/interview/starAnswers.ts), not AI-generated:
  // Situation/Task come from the resume's own structured experience data (company/title/dates),
  // Action is the cited bullet's verbatim text, Result is only populated when that bullet
  // contains an extractable number/metric — otherwise left null and shown as "not specified"
  // rather than invented.
  starSituation String?
  starTask      String?
  starAction    String?
  starResult    String?
  citedEntityIds String // JSON string[] — empty if no verified evidence was available

  rehearsed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mockAttempts MockInterviewAttempt[]

  @@index([interviewPrepId])
}

model MockInterviewAttempt {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviewQuestionId String
  interviewQuestion   InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)

  responseText String

  // 0-100 each. Scored on the response's own structure/content only — the rubric never asks
  // the AI to claim anything about the candidate beyond what's in the typed response.
  scoreRelevance    Int
  scoreClarity      Int
  scoreStructure    Int
  scoreCompleteness Int
  feedback          String

  createdAt DateTime @default(now())

  @@index([userId, interviewQuestionId])
  @@index([interviewQuestionId])
}

model Contact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name String
  role String?

  // HIRING_MANAGER | RECRUITER | TEAM_LEAD | EXISTING_CONNECTION | REFERRAL | OTHER
  contactType String @default("OTHER")

  // USER_SUPPLIED is the only source implemented — licensed contact enrichment (Apollo/Hunter/
  // ContactOut) is real per the PRD but needs an account we can't create on the user's behalf;
  // "PROVIDER_VERIFIED" is a valid future value with no code path that produces it today.
  source String @default("USER_SUPPLIED")

  // The user's own account of how/why this person is relevant — never an AI-inferred guess.
  // The co-founder analysis explicitly flags inferred contacts as something that "probably
  // shouldn't be shown at all without a verification path" — so nothing here is inferred.
  relationshipNote String?

  // 0-100, user-set; null = not rated. Never computed from scraped/enriched signals we don't have.
  warmth Int?

  profileUrl String? // user-supplied LinkedIn profile URL — never fetched server-side

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages OutreachMessage[]

  @@index([userId, jobId])
  @@index([jobId])
}

model OutreachMessage {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // CONNECTION_REQUEST | AFTER_CONNECT | RECRUITER_MESSAGE | HIRING_MANAGER_MESSAGE |
  // REFERRAL_ASK | FOLLOW_UP
  messageType String

  content        String
  citedEntityIds String // JSON string[]

  // DRAFT | SENT — SENT is only ever set by an explicit "mark as sent" user action, never by
  // this app actually sending anything. No code path here calls any messaging API.
  status String    @default("DRAFT")
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contactId, messageType])
  @@index([userId, contactId])
}

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetTitles      String? // JSON string[]
  targetLocations   String? // JSON string[]
  salaryFloor       Int?
  workAuthorization String?

  // Days after applying before a follow-up is due. User-configurable; PRD's "MVP: manual
  // timers" — this is a fixed offset computed once at Applied time, not a smart/adaptive one.
  followUpDays Int @default(7)

  // Opt-in, defaults to false — matches the registration page's promise that nothing is used to
  // train models unless explicitly turned on here. No training pipeline exists in this codebase
  // today (the Anthropic API this app calls does not train on API traffic regardless), so this
  // flag currently has no consuming system; it exists so one can be built later already gated
  // correctly, rather than retrofitting consent after the fact.
  aiTrainingOptIn Boolean @default(false)

  // IANA zone name (e.g. "America/Chicago"). Defaults to UTC — an honest, unambiguous default
  // rather than guessing the user's real zone from IP/locale, which this app has no signal for
  // server-side. Every daily-briefing cron/display computation reads this field; nothing infers
  // a zone silently (see lib/time/zonedTime.ts).
  timezone String @default("UTC")

  updatedAt DateTime @updatedAt
}

model AIInteraction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  toolName        String // "resume.extract" | "job.extract" | "match.score" | "assistant.<intent>"
  provider        String // "mock" | "anthropic"
  providerVersion String? // the model name for real AI calls, e.g. "claude-sonnet-5" — null for the mock provider, which makes no real model call
  inputRef        String // id/hash reference, not full payload
  outputRef       String
  status          String // SUCCESS | ERROR
  errorMessage    String?

  // Token/cost tracking (AI cost control) — all null for mock-provider rows, since there is no
  // real API call or cost to record. Populated from the Anthropic SDK's own response.usage via
  // lib/ai/usageTracking.ts; estimatedCostUsd is a directional estimate (lib/ai/pricing.ts), not
  // an exact invoice line.
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Every user has at most one Subscription row, created lazily (defaults to FREE/ACTIVE) the
// first time entitlements are checked — there's no separate "sign up for free" step. Stripe
// fields stay null until a real checkout completes; the webhook handler is the only writer of
// stripe*/currentPeriodEnd/cancelAtPeriodEnd, never a client-facing route, so this table can
// never drift from what Stripe actually thinks is true.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   String @default("FREE") // FREE | PRO
  status String @default("ACTIVE") // ACTIVE | TRIALING | PAST_DUE | CANCELED | INCOMPLETE

  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?

  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Written by the default "console" MailProvider (lib/mail/) in place of real email delivery —
// no SMTP/Resend credentials exist in this environment. Swappable to a real provider later
// without touching call sites; this table (and its /dev/outbox viewer) is dev/staging-only and
// hard-guarded against ever rendering in a production build.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}

// Expo push tokens are opaque, rotate-able strings tied to a specific app install — a user can
// have more than one (e.g. phone + tablet, or a reinstall that issued a new token before the old
// one was cleaned up), so this is many-per-user, not a single column on User.
model PushToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String @unique // Expo push token, e.g. "ExponentPushToken[xxxx]"
  platform String // IOS | ANDROID | WEB -- WEB is stored but never targeted by the sender (no real
  // web push capability exists in this build; see lib/push/providers/expoPush.ts)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Idempotency/dedup log for the hourly daily-briefing cron -- this table is what prevents the
// same person getting today's briefing twice across multiple hourly ticks within their local
// morning window, and is also the "new jobs since when" cursor for lib/briefing/subFacts.ts.
model DailyBriefingLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The user's own local calendar date at send time, e.g. "2026-08-17" -- a string, not a
  // DateTime, specifically so the uniqueness constraint means "this local day" regardless of what
  // UTC instant that mapped to, which is exactly what "don't double-send this morning" requires.
  localDate String
  sentAt    DateTime @default(now())

  @@unique([userId, localDate])
  @@index([userId])
}

// Written by the console/test PushProvider (lib/push/providers/console.ts) in place of a real
// device push -- mirrors EmailLog's role exactly, used when EXPO_PUSH_DISABLED=true (local
// dev/tests) so no real Expo push service call happens.
model PushLog {
  id        String   @id @default(cuid())
  to        String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([to, createdAt])
}
