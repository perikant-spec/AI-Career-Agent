# Staging environment template — this is what gets set in the staging deployment's hosting
# platform (Vercel/Render/Fly/etc.) environment variable configuration, never committed as a
# real .env file. Staging runs the same NODE_ENV=production build as production (see
# next.config.ts's isProd — same security headers, same optimizations) but is NOT held to
# lib/env.ts's assertProductionSafety() checks, which only run when APP_ENV=production. That
# means staging can legitimately point at a smaller/shared database, skip paid integrations, etc.
# — the one thing staging must never do is share a database, storage bucket, or Stripe/Anthropic
# account with production.
APP_ENV="staging"

# A real Postgres instance dedicated to staging — never the same database as production, and
# never localhost (that's dev). A smaller/cheaper tier than production's is fine.
DATABASE_URL="postgresql://<user>:<password>@<staging-db-host>:5432/ai_career_agent?schema=public&connection_limit=10&pool_timeout=20"

# Generate a real secret distinct from production's: `npx auth secret`
AUTH_SECRET=""
AUTH_URL="https://staging.example.com"

# Recommended for staging so uploaded test files don't accumulate as untracked local disk state
# on the staging host and to exercise the same code path production uses. A separate bucket from
# production's — never share one.
# S3_BUCKET=""
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# Optional — same as production's, but a separate API key/budget so staging traffic (including
# CI-driven smoke tests) never counts against production's AI spend.
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
# AI_FREE_DAILY_BUDGET_USD="0.50"
# AI_PRO_DAILY_BUDGET_USD="5.00"

# Optional integrations — use their own staging/sandbox equivalents (Stripe test mode keys,
# Adzuna's real API is free-tier and shared, RESEND in sandbox mode), never production credentials.
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRO_PRICE_ID=""
# ADZUNA_APP_ID=""
# ADZUNA_APP_KEY=""
# RESEND_API_KEY=""

# Never set in staging — see .env.example's note; this is dev/CI-only and is double-gated on
# NODE_ENV in lib/security/rateLimit.ts regardless, but should never appear here at all.
# RATE_LIMIT_DISABLED="true"
